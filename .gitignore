# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
shubh_vivahs-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# Hologram-generated client-side JS bundles and compiler artifacts.
/priv/static/hologram/

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Unrelated personal files that have ended up in this directory.
/Birthday foto/

# Face detection: downloaded ONNX models + bundled ffmpeg binary
# (fetched by `mix face_detection.setup`), plus SQLite db files.
/priv/face_detection/models/
/priv/face_detection/bin/
*.db
*.db-shm
*.db-wal

# Generated low-bitrate preview proxies (mix premiere.generate_previews).
/priv/face_detection/previews/

# Generated independently-playable download segments (VideoSegments).
/priv/face_detection/movie_segments/

# Generated face crop thumbnails, movie poster thumbnails, and cached
# movie metadata.
/priv/face_detection/thumbnails/
/priv/face_detection/movie_thumbnails/
/priv/face_detection/movie_metadata/

# User-uploaded profile photos (AccountAvatarController/AvatarUpload).
/priv/avatars/

# User-uploaded source videos (VideoUploadController/VideoUpload).
/priv/face_detection/uploads/

# Media library copies, subtitles, and thumbnails (mix library.import),
# and the source folders dropped in the project root to import from.
/priv/library/
# Documents kept alongside the library (e-books, PDFs) — not served by the app.
/priv/books/
/log/
/Game of Thrones Season */

logo.jpeg
images-removebg-preview.png

# Photo albums: moved-in originals plus web copies and thumbnails (ShubhVivahs.Photos).
/priv/photos/
